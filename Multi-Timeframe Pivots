// =============================================================================
// GLOBALS & HELPER FUNCTIONS
// =============================================================================
int MAX_DRAWING_OBJECTS = 500
float atrVal            = nz(ta.atr(14))
float priceOffset       = atrVal * 0.2

// Function to detect pivots manually
checkForPivot(array<float> history, int pivot_idx, int left_strength, int right_strength, bool is_high, bool allowFlat) =>
    bool is_pivot = true
    if array.size(history) < left_strength + right_strength + 1 or pivot_idx < left_strength or pivot_idx > array.size(history) - 1 - right_strength
        is_pivot := false
    else
        float pivot_price = array.get(history, pivot_idx)
        for i = 0 to left_strength + right_strength
            if i != left_strength
                float neighbor_price = array.get(history, pivot_idx - left_strength + i)
                if is_high
                    if allowFlat ? neighbor_price > pivot_price : neighbor_price >= pivot_price
                        is_pivot := false
                        break
                else
                    if allowFlat ? neighbor_price < pivot_price : neighbor_price <= pivot_price
                        is_pivot := false
                        break
    is_pivot

// Dynamic Label Drawing with returns for management
drawPivotLabel(array<label> labelsArray, int bar_time, float price, color p_color, string txt, bool isHigh, bool showCross, bool showText, string tSize, float offset) =>
    float crossPrice = isHigh ? price + offset : price - offset
    label xLbl = na
    label tLbl = na
    if showCross
        xLbl := label.new(bar_time, crossPrice, text="", xloc=xloc.bar_time, style=label.style_xcross, color=p_color, size=size.tiny)
        array.push(labelsArray, xLbl)
    if showText and txt != ""
        lblStyle = isHigh ? label.style_label_down : label.style_label_up
        tLbl := label.new(bar_time, crossPrice, text=txt, xloc=xloc.bar_time, style=lblStyle, color=color.new(p_color, 100), textcolor=p_color, size=tSize)
        array.push(labelsArray, tLbl)
    if array.size(labelsArray) > MAX_DRAWING_OBJECTS
        label.delete(array.shift(labelsArray))
    [xLbl, tLbl]

// =============================================================================
// DEFINITION: SESSION LOGIC
// =============================================================================
processSessionLogic(bool enable, bool showMarkers, string tf, color cHigh, color cLow, float offset) =>
    bool isActive    = enable and tf != ''
    bool isNewSesBar = isActive and nz(ta.change(time(tf))) != 0
    var label[] sLabels = array.new_label()
    var float sH = high, var float sL = low
    var int sHT = time, var int sLT = time
    
    if isNewSesBar
        if not na(sH) and showMarkers
            // Session high marker now uses 'offset' for consistency
            drawPivotLabel(sLabels, sHT, sH, cHigh, "", true, true, false, size.tiny, offset)
        if not na(sL) and showMarkers
            // Session low marker now uses 'offset' for consistency
            drawPivotLabel(sLabels, sLT, sL, cLow, "", false, true, false, size.tiny, offset)
        sH := high, sL := low, sHT := time, sLT := time
    else if isActive
        if high >= sH
            sH := high, sHT := time
        if low <= sL
            sL := low, sLT := time

// =============================================================================
// DEFINITION: PIVOT LOGIC
// =============================================================================
processPivotLogic(bool enable, bool showPivots, bool showText, string tf, int leftBars, int rightBars, color phColor, color plColor, float offset, bool filterActive, bool flatActive, string tSize) =>
    bool isHistoryActive = enable and tf != ''
    bool is_new_bar      = isHistoryActive and (nz(ta.change(time(tf))) != 0)

    var string lastPivotType  = "NONE" 
    var float  lastPivotPrice = na
    var float  prevHighPrice  = na
    var float  prevLowPrice   = na
    
    var label lastHCross = na, var label lastHText = na
    var label lastLCross = na, var label lastLText = na

    var label[] pivotLabels   = array.new_label()
    var float   session_h     = high
    var float   session_l     = low
    var int     session_h_t   = time
    var int     session_l_t   = time
    
    var array<float> h_history = array.new_float()
    var array<float> l_history = array.new_float()
    var array<int>   h_times   = array.new_int()
    var array<int>   l_times   = array.new_int()

    if isHistoryActive
        if is_new_bar
            session_h := high, session_l := low
            session_h_t := time, session_l_t := time
        else
            if high >= session_h
                session_h := high, session_h_t := time
            if low <= session_l
                session_l := low, session_l_t := time

        if is_new_bar
            array.push(h_history, session_h[1]), array.push(h_times, session_h_t[1])
            array.push(l_history, session_l[1]), array.push(l_times, session_l_t[1])

            int check_idx = array.size(h_history) - 1 - rightBars
            if check_idx >= 0
                // --- HIGH PIVOT (Strict Zig-Zag) ---
                if checkForPivot(h_history, check_idx, leftBars, rightBars, true, flatActive)
                    float p_price = array.get(h_history, check_idx)
                    int p_time    = array.get(h_times, check_idx)
                    bool canDraw  = false
                    if filterActive
                        if lastPivotType != "HIGH"
                            canDraw := true
                        else if p_price > lastPivotPrice // Replace with Higher High
                            label.delete(lastHCross), label.delete(lastHText)
                            canDraw := true
                    else
                        canDraw := true

                    if canDraw
                        string t = na(prevHighPrice) ? "H" : (p_price > prevHighPrice ? "HH" : (p_price < prevHighPrice ? "LH" : "H"))
                        [xc, tl] = drawPivotLabel(pivotLabels, p_time, p_price, phColor, t, true, showPivots, showText, tSize, offset)
                        lastHCross := xc, lastHText := tl
                        lastPivotPrice := p_price, prevHighPrice := p_price, lastPivotType := "HIGH"

                // --- LOW PIVOT (Strict Zig-Zag) ---
                if checkForPivot(l_history, check_idx, leftBars, rightBars, false, flatActive)
                    float p_price = array.get(l_history, check_idx)
                    int p_time    = array.get(l_times, check_idx)
                    bool canDraw  = false
                    if filterActive
                        if lastPivotType != "LOW"
                            canDraw := true
                        else if p_price < lastPivotPrice // Replace with Lower Low
                            label.delete(lastLCross), label.delete(lastLText)
                            canDraw := true
                    else
                        canDraw := true

                    if canDraw
                        string t = na(prevLowPrice) ? "L" : (p_price < prevLowPrice ? "LL" : (p_price > prevLowPrice ? "HL" : "L"))
                        [xc, tl] = drawPivotLabel(pivotLabels, p_time, p_price, plColor, t, false, showPivots, showText, tSize, offset)
                        lastLCross := xc, lastLText := tl
                        lastPivotPrice := p_price, prevLowPrice := p_price, lastPivotType := "LOW"

// =============================================================================
// EXECUTION
// =============================================================================
processSessionLogic(enableSession, showSessionMarkers, sessionTimeframe, sessionHighColor, sessionLowColor, priceOffset)

processPivotLogic(enableTF1, showCross1, showText1, tf1, lb1, rb1, phc1, plc1, priceOffset, enableSequenceFilter, allowEqualPivots, textSize)
processPivotLogic(enableTF2, showCross2, showText2, tf2, lb2, rb2, phc2, plc2, priceOffset, enableSequenceFilter, allowEqualPivots, textSize)
processPivotLogic(enableTF3, showCross3, showText3, tf3, lb3, rb3, phc3, plc3, priceOffset, enableSequenceFilter, allowEqualPivots, textSize)
processPivotLogic(enableTF4, showCross4, showText4, tf4, lb4, rb4, phc4, plc4, priceOffset, enableSequenceFilter, allowEqualPivots, textSize)
processPivotLogic(enableTF5, showCross5, showText5, tf5, lb5, rb5, phc5, plc5, priceOffset, enableSequenceFilter, allowEqualPivots, textSize)
processPivotLogic(enableTF6, showCross6, showText6, tf6, lb6, rb6, phc6, plc6, priceOffset, enableSequenceFilter, allowEqualPivots, textSize)
